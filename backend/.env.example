# Copy this file to .env and fill in your own values. Never commit the real .env file.

# --- Binance API credentials ---
# Required for testnet and live modes. Not required for paper mode (uses public market data only).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Live trading safety gate ---
# Must be explicitly set to "true" for the backend to accept any bot start request
# with mode=live. This is a deliberate second lock in addition to the confirmation
# flag sent from the UI, so real-money trading can never be turned on by accident.
ALLOW_LIVE_TRADING=false

# --- Server config ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000
