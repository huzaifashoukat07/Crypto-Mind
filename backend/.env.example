# Copy this file to .env and fill in your own values. Never commit the real .env file.

# --- Binance API credentials ---
# Required for testnet and live modes. Not required for paper mode (uses public market data only).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Live trading safety gate ---
# Must be explicitly set to "true" for the backend to accept any bot start request
# with mode=live. This is a deliberate second lock in addition to the confirmation
# flag sent from the UI, so real-money trading can never be turned on by accident.
ALLOW_LIVE_TRADING=false

# --- Server config ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000

# --- Telegram trade notifications (optional) ---
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts -> it
#    gives you a bot token immediately.
# 2. Send any message to your new bot, then open in a browser:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    Find "chat":{"id": ...} in the response -- that number is your chat ID.
# Leave both blank to disable notifications entirely (default).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API authentication ---
# Required if this backend is reachable from anywhere other than your own
# localhost (e.g. deployed on a VPS/cloud VM) -- there is no other access
# control on the API. Set this to a long random string and enter the same
# value in the frontend's API token prompt. Leave blank ONLY for strictly
# local-machine use.
API_AUTH_TOKEN=
